---
import { SITE, SITE_URL } from '../site';
interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  tags?: string[];
  bodyClass?: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
  image?: string; // social preview image (path on this site); defaults to /assets/og.png
}
const { title, description = SITE.description, type = 'website', published, modified, tags = [], bodyClass, jsonld, noindex, image = '/assets/og.png' } = Astro.props;
// Search results show about 60 characters: drop the name suffix when it would push the title past that.
const fullTitle = title === SITE.name ? `${SITE.name} · ${SITE.role}` : `${title} · ${SITE.name}`.length <= 60 ? `${title} · ${SITE.name}` : title;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nihal Vellaramkallingal Sulaiman',
  alternateName: 'Nihal Sulaiman',
  jobTitle: SITE.role,
  image: SITE_URL + '/assets/photo.jpg',
  email: 'mailto:' + SITE.email,
  url: SITE_URL + '/',
  address: { '@type': 'PostalAddress', addressLocality: 'Niagara Falls', addressRegion: 'ON', addressCountry: 'CA' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Niagara Falls Canada' },
    { '@type': 'CollegeOrUniversity', name: 'Cochin University of Science and Technology' },
  ],
  sameAs: [SITE.links.github, SITE.links.linkedin, SITE.links.kaggle],
};
// Pages without their own structured data say what they are and where they sit (breadcrumbs), next to who runs the site.
const segs = Astro.url.pathname.split('/').filter(Boolean);
const label = (s: string) => s.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase());
const crumbs = [{ name: 'Home', url: SITE_URL + '/' }, ...segs.map((s, i) => ({ name: i === segs.length - 1 ? title : label(s), url: `${SITE_URL}/${segs.slice(0, i + 1).join('/')}/` }))];
const { '@context': _c, ...personNode } = person;
const ld = jsonld ?? (segs.length === 0 || noindex ? person : {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': type === 'article' ? 'Article' : 'WebPage', name: title, headline: type === 'article' ? title.slice(0, 110) : undefined, description, url: canonical, inLanguage: 'en-CA',
      datePublished: published?.toISOString(), dateModified: (modified ?? published)?.toISOString(), author: type === 'article' ? { '@id': SITE_URL + '/#me' } : undefined,
      isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE_URL + '/' } },
    { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) },
    { ...personNode, '@id': SITE_URL + '/#me' },
  ],
});
const v = Date.now().toString(36); // changes every build, so browsers fetch fresh CSS and JS
---
<!doctype html>
<html lang="en-CA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex ? <meta name="robots" content="noindex"> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">}
<meta name="author" content="Nihal Sulaiman">
<meta property="og:site_name" content={SITE.name}>
<meta property="og:type" content={type}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(image, SITE_URL).href}>
<meta name="twitter:image" content={new URL(image, SITE_URL).href}>
<meta name="twitter:card" content="summary_large_image">
{published && <meta property="article:published_time" content={published.toISOString()}>}
{modified && <meta property="article:modified_time" content={modified.toISOString()}>}
{type === 'article' && <meta property="article:author" content={SITE_URL + '/about/'}>}
{type === 'article' && tags.map((t) => <meta property="article:tag" content={t}>)}
<meta property="og:locale" content="en_CA">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="theme-color" content="#ffffff">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231d4ed8'/%3E%3Cg fill='%23fff'%3E%3Ccircle cx='10' cy='11' r='3'/%3E%3Ccircle cx='22' cy='11' r='3'/%3E%3Ccircle cx='16' cy='22' r='3'/%3E%3C/g%3E%3C/svg%3E">
<link rel="alternate" type="application/rss+xml" title="Nihal Sulaiman · Blog" href="/rss.xml">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/fonts/fonts.css">
<link rel="stylesheet" href={`/assets/site.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/blog.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/home.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/mobile.css?v=${v}`}>
<script is:inline src={`/assets/header.js?v=${v}`}></script>
<script is:inline defer src={`/assets/counter.js?v=${v}`}></script>
<script is:inline defer src={`/assets/localtime.js?v=${v}`}></script>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class={bodyClass}>
<site-header></site-header>
<slot />
<site-footer></site-footer>
</body>
</html>

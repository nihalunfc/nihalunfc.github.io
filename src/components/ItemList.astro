---
// A compact list of tools, projects and swarm items, used on field pages.
interface Item { href: string; title: string; note: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ul class="hub-list">{items.map((i) => <li><a href={i.href}>{i.title}</a><span>{i.note}</span></li>)}</ul>

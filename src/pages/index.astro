---
import Base from '../layouts/Base.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { SITE } from '../site';
import LogList from '../components/LogList.astro';
import { getPosts, getLog, fmtDate } from '../lib';
const posts = (await getPosts()).slice(0, 3);
const log = (await getLog()).slice(0, 4);
import { getEntry } from 'astro:content';
import Progress from '../components/Progress.astro';
import { partsFor } from '../lib';
const bi = await getEntry('projects', 'bi-toolkit');
---
<Base title={SITE.name}>
<main class="hub">
  <section class="hub-top">
    <img class="hub-photo" src="/assets/photo.jpg" alt="Nihal Sulaiman" width="88" height="88">
    <div class="hub-id">
      <h1><b>Nihal</b> Vellaramkallingal Sulaiman</h1>
      <p class="hub-tag">Data analyst and BI developer · Niagara Falls, Ontario · open to roles anywhere in Ontario</p>
      <ProfileLinks />
    </div>
    <form class="home-search" action="/search/" role="search"><input name="q" type="search" placeholder="Search projects, posts and tools" aria-label="Search this site"><button type="submit">Search</button></form>
  </section>

  <div class="hub-grid">
    <div class="card w2"><h2><i></i>About</h2>
      <p>This site is everything I think up, build and deploy, so you can see how I work. Most of it is business intelligence: pipelines that pull data out of the systems people already have, clean it, store it in a warehouse and put the answer on a dashboard. I build each tool once and fit it to each field, from shops and clinics to banks and research labs. <b>Master's in Data Analytics</b> (2026) and <b>MSc in Physics</b> (cosmology).</p>
      <p class="more"><a href="/about/">More about me</a><a href="/nihal-sulaiman-cv.pdf" type="application/pdf">CV (PDF)</a><a href="/contact/">Contact</a></p>
    </div>

    <div class="card w2 flagship"><h2><i class="ai"></i><a href="/swarm/">Swarm Intelligence</a> <span class="flag">Flagship</span></h2>
      <p>One multi-agent engine where every battery, drone or hotel system makes its own decision and the group still acts as one team. Now focused on energy grids, oil and gas, and wildfires, with tools for Canadian governments in mind, plus a study of how real bird flocks move.</p>
      <div class="kv"><span><b>704 MW</b>average grid peak cut</span><span><b>10.8%</b>smoother grid demand</span><span><b>0.96</b>CityLearn score vs 1.03 for its tuned rule (lower wins)</span></div>
      <div class="acts"><span class="acts-l">Live demos:</span><a class="btn primary sm" href="/swarm/grid-batteries/">Grid batteries</a><a class="btn primary sm" href="/swarm/wildfire-drones/">Wildfire drones</a><a class="btn primary sm" href="/swarm/hotel-operations/">Hotel operations</a><a class="btn ghost sm" href="/swarm/">How it works</a></div>
    </div>

    <div class="card"><h2><i></i>What I build</h2>
      <ul class="tight">
        <li>ETL pipelines and automation</li>
        <li>Data cleaning and quality checks</li>
        <li>Data warehouses and star schemas</li>
        <li>BI dashboards and reports</li>
        <li>AI-assisted automation with Claude Code</li>
      </ul>
      <p class="more"><a href="/tools/">Tools</a><a href="/projects/">Projects</a></p>
    </div>

    <div class="card"><h2><i></i>Fields</h2>
      <p class="chips sm"><a href="/fields/hospitality/">Hospitality</a><a href="/fields/retail/">Retail</a><a href="/fields/logistics/">Logistics</a><a href="/fields/energy/">Energy</a><a href="/fields/crisis/">Crisis management</a><a href="/fields/science/">Science</a><a href="/fields/health/">Health</a><a href="/fields/finance/">Finance</a></p>
      <p style="margin-top:8px">Each with BI, optimisation, tools, pipelines and machine learning.</p>
      <p class="more"><a href="/fields/">All fields</a></p>
    </div>

    <div class="card"><h2><i></i>Learn with me</h2>
      <p><b>Pipeline to Dashboard</b>, a free 7-week course in ETL, warehousing and BI, and <b>Data at Scale</b>, 30 lessons on Spark, Google Cloud, Kafka and streaming. No sign-up; progress stays in your browser.</p>
      <p class="more"><a href="/learn/">Start learning</a></p>
    </div>

    <div class="card"><h2><i></i>Looking for</h2>
      <p>Data analyst, BI developer or data science roles in Ontario. Full-time, part-time or internship, on site or remote. Available now.</p>
      <p class="more"><a href="/contact/">Get in touch</a></p>
    </div>

    <div class="card"><h2><i></i>Now</h2>
      <ul class="tight">
        <li>Data Engineer (remote) at Shipd by DataCurve</li>
        <li>Building <a href="/projects/self-healing-pipelines/">self-healing pipelines</a>: AI agents that fix ETL failures</li>
        <li>Turning my BI tools into ETL pipelines on Azure SQL</li>
        <li>Restaurant-chain and retail editions of the BI toolkit</li>
        <li>Learning T-SQL, Power BI and dbt</li>
        <li>Four live Kaggle competitions</li>
      </ul>
      <p class="more"><a href="/now/">Now page</a></p>
    </div>

    <div class="card"><h2><i class="bi"></i><a href="/projects/bi-toolkit/">BI toolkit</a></h2>
      <p>One warehouse model, ten data-quality checks and 12 decision tools, fitted to each sector. Hospitality is live; restaurant chains and retail are next.</p>
      <div class="kv"><span><b>14</b>tools</span><span><b>10</b>quality checks</span><span><b>3</b>editions</span></div>
      {bi && <Progress parts={partsFor(bi.data)} compact />}
      <div class="acts"><a class="btn primary sm" href="/tools/revenue-command-centre/hotels/">Live dashboard</a><a class="btn ghost sm" href="/tools/">All tools</a><a class="btn ghost sm" href="https://github.com/nihalunfc/hotel-business">Code</a></div>
    </div>

    <a class="card proj-c" href="/projects/kaggle/"><h2><i class="kg"></i>Kaggle</h2>
      <p>Name That LLM, CASMI 2026, NeurIPS Smart Buildings and Squares in Squares, with honest notes on what's my own work.</p>
      <div class="kv"><span><b>Top 10%</b>Name That LLM</span><span><b>Top 13%</b>Squares</span></div>
    </a>

    <div class="card"><h2><i></i>Latest writing</h2>
      <ul class="hub-list">{posts.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a><span>{fmtDate(p.data.date)}</span></li>)}</ul>
      <p class="more"><a href="/blog/">All posts</a><a href="/rss.xml">RSS</a></p>
    </div>

    <div class="card"><h2><i></i>Activity log</h2>
      <LogList entries={log} compact />
      <p class="more"><a href="/log/">Full log</a></p>
    </div>

    <div class="card"><h2><i></i>News</h2>
  <dl class="news">
    <dt>Nov 2026</dt><dd>Published <a href="/projects/self-healing-pipelines/">Self-healing pipelines</a>: a crew of nine AI agents with no boss that finds, fixes and re-runs most ETL failures, open source under the MIT License.</dd>
    <dt>Nov 2026</dt><dd>Re-ran the 1960 <a href="/blog/doomsday-2026-restudy/">Doomsday paper</a> against 65 years of World Bank data, with the code and data to reproduce it.</dd>
    <dt>Nov 2026</dt><dd>Published <a href="/learn/big-data-cloud/">Data at Scale</a>, a free 30-lesson course in big data, Google Cloud and streaming.</dd>
    <dt>Nov 2026</dt><dd>Started a <a href="/blog/">blog</a> with write-ups of my projects and Kaggle work, and moved this site to nihalsulaiman.com.</dd>
    <dt>Nov 2026</dt><dd>Added an <a href="https://github.com/nihalunfc/hotel-business/tree/main/ai-workflow">AI workflow kit</a> to the Hospitality BI portfolio: safety rules for Claude Code on a live warehouse, an ETL triage method and a tested read-only SQL runner.</dd>
    <dt>Nov 2026</dt><dd>Currently in the top 10% of 4,346 on the public leaderboard of Kaggle's <i>Name That LLM</i> competition.</dd>
    <dt>Oct 2026</dt><dd>Graduated with a Master's in Data Analytics.</dd>
    <dt>Oct 2026</dt><dd>Launched the <a href="/projects/hospitality-bi/overview/">Hospitality BI portfolio</a>: a revenue command centre, a staff schedule builder and 12 hotel tools on a five-hotel sample group.</dd>
    <dt>Sep 2026</dt><dd>Built <a href="https://github.com/nihalunfc/GDGCHackathon2026">WARL</a>, a drone-swarm wildfire response with a live dashboard, at the GDG on Campus Build with AI hackathon.</dd>
  </dl>

    </div>

    <div class="card"><h2><i></i>More projects</h2>
      <ul class="hub-list">
        <li><a href="/projects/self-healing-pipelines/">Self-healing pipelines</a><span>Multi-agent AI, 2026</span></li>
        <li><a href="/projects/warl-wildfire/">WARL wildfire drone swarm</a><span>Hackathon, 2026</span></li>
        <li><a href="/projects/casmi-2026/">CASMI 2026 leak-free validation</a><span>Kaggle</span></li>
        <li><a href="/projects/smart-buildings/">NeurIPS Smart Buildings</a><span>Kaggle</span></li>
      </ul>
      <p class="more"><a href="/projects/">All projects</a></p>
    </div>

    <div class="card"><h2><i></i>Free tools</h2>
      <ul class="hub-list">
        <li><a href="/tools/pricing-recommender/">Pricing recommender</a><span>Pricing</span></li>
        <li><a href="/tools/shift-scheduler/">Shift schedule builder</a><span>People</span></li>
        <li><a href="/tools/demand-forecaster/">Demand forecaster</a><span>Planning</span></li>
        <li><a href="https://fibub.com/">Everyday tools on fibub</a><span>Personal</span></li>
      </ul>
      <p class="more"><a href="/tools/">All tools</a></p>
    </div>

    <div class="card"><h2><i></i>Education</h2>
      <ul class="hub-list">
        <li><b>Master's, Data Analytics</b><span>University of Niagara Falls Canada · 2026</span></li>
        <li><b>MSc Physics</b><span>CUSAT, India · 2017 – 2019</span></li>
        <li><b>BSc Physics</b><span>University of Calicut, India · 2013 – 2016</span></li>
      </ul>
    </div>

    <div class="card"><h2><i></i>Skills</h2>
      <div class="chips sm"><span>SQL</span><span>Python</span><span>Power BI</span><span>Excel</span><span>Star schemas</span><span>ETL</span><span>Forecasting</span><span>PuLP</span><span>XGBoost</span><span>PyTorch</span><span>D3</span><span>Git</span></div>
    </div>
  </div>
</main>
</Base>

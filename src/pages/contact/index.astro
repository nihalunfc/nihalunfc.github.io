---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE, SITE_URL } from '../../site';
// The form posts to FormSubmit, a free service that forwards each message to SITE.email.
// The very first message triggers a one-time "Activate form" email to that inbox.
const action = `https://formsubmit.co/${SITE.email}`;
---
<Base title="Contact" description="Contact Nihal Sulaiman about data analyst, BI developer and data science roles in Ontario, or about any project on this site.">
  <PageHero title="Contact me" crumbs={[{ label: 'Contact' }]} lead="Hiring for a data or BI role, have a question about a project, or want to work on something together? Send me a message and I'll reply by email, usually within a day." />
  <main>
    <div class="contact-grid">
      <form class="card cform" action={action} method="POST">
        <input type="hidden" name="_subject" value="New message from nihalsulaiman.com">
        <input type="hidden" name="_next" value={`${SITE_URL}/contact/thanks/`}>
        <input type="hidden" name="_template" value="table">
        <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <label>Your name<input name="name" required autocomplete="name"></label>
        <label>Your email<input type="email" name="email" required autocomplete="email"></label>
        <label>What's it about?
          <select name="topic">
            <option>A job or internship</option>
            <option>A project on this site</option>
            <option>Freelance or collaboration</option>
            <option>Something else</option>
          </select>
        </label>
        <label>Message<textarea name="message" rows="7" required></textarea></label>
        <button class="btn primary" type="submit">Send message</button>
        <p class="fine">Your message is sent by email through FormSubmit. Nothing is stored on this site.</p>
      </form>
      <div class="side">
        <div class="card">
          <h2>Email</h2>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <h2>Elsewhere</h2>
          <p><a href={SITE.links.linkedin}>LinkedIn</a> · <a href={SITE.links.github}>GitHub</a> · <a href={SITE.links.kaggle}>Kaggle</a></p>
          <h2>Location</h2>
          <p>Niagara Falls, Ontario. Open to roles anywhere in Ontario, on site or remote.</p>
          <p><a href="/cv/">View my CV →</a></p>
        </div>
      </div>
    </div>
  </main>
</Base>

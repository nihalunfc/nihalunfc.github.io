---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE, SITE_URL } from '../../site';
import { getPosts, fmtDate, readingTime, slugify } from '../../lib';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const mins = readingTime(post.body);
// First image in the post (if any) becomes its social-preview and search image.
const firstImg = (post.body ?? '').match(/!\[[^\]]*\]\((\/[^)\s]+\.(?:png|jpe?g|webp))\)/i)?.[1];
const url = new URL(`/blog/${post.id}/`, SITE_URL).href;
const faq = post.data.faq;
// Strip simple Markdown (links, bold) from FAQ answers for the structured data.
const plain = (t: string) => t.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/\*\*([^*]+)\*\*/g, '$1');
// Inline Markdown for the visible FAQ answers: links and bold only.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inline = (t: string) => esc(t).replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
const article = {
  '@type': 'BlogPosting',
  '@id': url + '#article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: 'Nihal Sulaiman', url: SITE_URL + '/about/' },
  publisher: { '@type': 'Person', name: 'Nihal Sulaiman', url: SITE_URL + '/' },
  mainEntityOfPage: url,
  inLanguage: 'en-CA',
  wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
  keywords: post.data.tags.join(', '),
  ...(firstImg ? { image: new URL(firstImg, SITE_URL).href } : {}),
};
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE_URL + '/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
};
const faqLd = faq.length ? [{
  '@type': 'FAQPage',
  '@id': url + '#faq',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
}] : [];
const ld = { '@context': 'https://schema.org', '@graph': [article, crumbs, ...faqLd] };
---
<Base title={post.data.seoTitle ?? post.data.title} description={post.data.description} type="article" published={post.data.date} modified={post.data.updated} tags={post.data.tags} jsonld={ld} image={firstImg}>
  <PageHero title={post.data.title} crumbs={[{ label: 'Blog', href: '/blog/' }, { label: 'Post' }]} lead={post.data.description}>
    <div class="post-meta">
      <span class="byline">By <a href="/about/" rel="author">Nihal Sulaiman</a></span>
      <span>·</span><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
      <span>·</span><span>{mins} min read</span>
      <span class="pv-dot" hidden>·</span><span data-views hidden></span>
      {post.data.updated && <><span>·</span><span>Updated {fmtDate(post.data.updated)}</span></>}
      <div class="tags">{post.data.tags.map((t) => <a class="tag" href={`/blog/tags/${slugify(t)}/`}>{t}</a>)}</div>
    </div>
  </PageHero>
  <main>
    <article class="prose">
      <Content />
      {faq.length > 0 && (
        <section class="faq" id="faq" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Frequently asked questions</h2>
          {faq.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p set:html={inline(f.a)} />
            </div>
          ))}
        </section>
      )}
    </article>
    <div class="post-foot">
      <div class="author">
        <div class="av" aria-hidden="true">N</div>
        <div>
          <b>Nihal Sulaiman</b>
          <p>Data analyst and BI developer in Ontario, with a Master's in Data Analytics and an MSc in Physics. I build hotel BI tools, compete on Kaggle and write about what I learn.</p>
          <div class="links"><a href={SITE.links.linkedin}>LinkedIn</a><a href={SITE.links.github}>GitHub</a><a href="/nihal-sulaiman-cv.pdf">CV (PDF)</a><a href="/rss.xml">RSS</a></div>
        </div>
      </div>
      {(newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {older && <a href={`/blog/${older.id}/`}><span>← Older</span>{older.data.title}</a>}
          {newer && <a class="next" href={`/blog/${newer.id}/`}><span>Newer →</span>{newer.data.title}</a>}
        </nav>
      )}
    </div>
  </main>
</Base>

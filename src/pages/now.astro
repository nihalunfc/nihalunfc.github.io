---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Now" description="What Nihal Sulaiman is working on right now: job search, current projects, Kaggle competitions and what he's learning.">
  <PageHero title="What I'm doing now" crumbs={[{ label: 'Now' }]} lead="A snapshot of my current work, updated whenever something changes. Inspired by the nownownow.com idea.">
    <p class="updated" style="margin-top:12px">Last updated 3 November 2026 · Niagara Falls, Ontario</p>
  </PageHero>
  <main>
    <div class="now-grid">
      <div class="card"><h2><i></i>Looking for work</h2><p>Data analyst, BI developer, data scientist or ML roles anywhere in Ontario: full-time, part-time or internship, on site or remote. Hospitality is the industry I know best, but I'm open to any sector.</p><p><a href="/cv/">View CV →</a></p></div>
      <div class="card"><h2><i></i>Working</h2><p>Remote AI training specialist with Shipd by DataCurve.</p></div>
      <div class="card"><h2><i></i>Building</h2><ul class="tight"><li>Turning the <a href="/projects/hospitality-bi/">hospitality BI tools</a> into scheduled ETL pipelines that load an Azure SQL Database.</li><li>More seeds and domains for <a href="/projects/swarm-intelligence/">Swarm Intelligence</a>.</li><li>This site and blog.</li></ul></div>
      <div class="card"><h2><i></i>Learning</h2><ul class="tight"><li>T-SQL and SQL Server, my main gap to close.</li><li>Power BI and DAX.</li><li>dbt and dimensional modelling, Dagster for orchestration.</li></ul></div>
      <div class="card"><h2><i></i>Competing</h2><ul class="tight"><li><a href="/projects/name-that-llm/">Name That LLM</a>, ends January 2027</li><li><a href="/projects/casmi-2026/">Enveda CASMI 2026</a>, ends December 2026</li><li><a href="/projects/smart-buildings/">NeurIPS Smart Buildings</a>, ends January 2027</li><li><a href="/projects/squares-in-squares/">Squares in Squares</a>, ends July 2027</li></ul></div>
      <div class="card"><h2><i></i>Writing</h2><p>Write-ups of each Kaggle competition as it ends, and notes on building BI pipelines on a small budget. <a href="/blog/">Read the blog →</a></p></div>
    </div>
  </main>
</Base>

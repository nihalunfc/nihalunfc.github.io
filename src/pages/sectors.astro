---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getTools, getProjects } from '../lib';
import { SECTORS, inSector } from '../data/sectors';
const tools = await getTools();
const projects = (await getProjects()).filter((p) => p.data.category !== 'Business intelligence');
---
<Base title="Who it's for" description="Data tools and pipelines by Nihal Sulaiman for retail, small businesses, hospitality, restaurants, logistics, finance and insurance, automotive, healthcare, research and everyday people.">
  <PageHero title="Who it's for" crumbs={[{ label: "Who it's for" }]} lead="The same skills, BI, ETL pipelines, data cleaning, warehouses and AI-assisted automation, fitted to different kinds of work. Pick yours to see what's built and what's planned." />
  <main>
    <div class="now-grid two">
      {SECTORS.map((s) => {
        const ts = tools.filter((t) => inSector(t.data.sectors, s));
        const ps = projects.filter((p) => inSector(p.data.sectors, s));
        return (
          <section class="card sector" id={s.id}>
            <h2><i></i>{s.name}</h2>
            <p class="muted">{s.blurb}</p>
            {(ts.length > 0 || ps.length > 0) && <ul class="hub-list">
              {ts.map((t) => <li><a href={`/tools/${t.id}/`}>{t.data.title}</a><span>Tool · {t.data.status}</span></li>)}
              {ps.map((p) => <li><a href={`/projects/${p.id}/`}>{p.data.title}</a><span>Project</span></li>)}
            </ul>}
            {s.ideas.length > 0 && <p class="ideas"><b>Planned:</b> {s.ideas.join(' · ')}</p>}
          </section>
        );
      })}
    </div>
    <div class="callout" style="margin-top:24px"><p>Don't see your field? Most of this is the same work underneath: get the data out of the systems you have, clean it, store it well and put the answer in front of the person who decides. <a href="/contact/">Tell me what you need</a>.</p></div>
  </main>
</Base>

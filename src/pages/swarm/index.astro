---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LogList from '../../components/LogList.astro';
import { Content as Intro } from '../../content-pages/swarm-intro.md';
import { FIELDS, fieldName } from '../../data/fields';
import { getLog } from '../../lib';
const items = (await getCollection('swarm')).sort((a, b) => a.data.order - b.data.order);
const used = new Set(items.map((i) => i.data.field));
const next = FIELDS.filter((f) => !used.has(f.id));
const updates = (await getLog()).filter((e) => (e.data.ref || '').startsWith('swarm'));
---
<Base title="Swarm Intelligence" description="Swarm Intelligence, Nihal Sulaiman's flagship project: one multi-agent engine where batteries, drones and hotel systems each decide for themselves and act as one team, applied across energy, crisis management, hospitality and more.">
  <PageHero title="Swarm Intelligence" crumbs={[{ label: 'Swarm' }]} lead="My flagship project: one multi-agent engine in which every agent makes its own decision and the group still acts as one team. Each application below is tested against the rule people use today." />
  <main>
    <div class="now-grid two">
      {items.map((i) => (
        <article class="card swarm-item">
          <p class="eyebrow" style="margin:0">{fieldName(i.data.field)} · {i.data.status}</p>
          <h2><a href={i.data.demo || `/swarm/${i.id}/`}>{i.data.title}</a></h2>
          <p>{i.data.summary}</p>
          {i.data.stats.length > 0 && <div class="stat-row">{i.data.stats.map((s) => <div><b>{s.value}</b>{s.label}</div>)}</div>}
          <div class="acts">
            {i.data.demo && <a class="btn primary sm" href={i.data.demo}>Open the live demo</a>}
            {i.data.code && <a class="btn ghost sm" href={i.data.code}>Code</a>}
            {i.data.project && <a class="btn ghost sm" href={`/projects/${i.data.project}/`}>Write-up</a>}
          </div>
        </article>
      ))}
      <section class="card">
        <h2><i></i>Coming to every field</h2>
        <p class="muted">The same engine will be applied in each of my fields. Next:</p>
        <ul class="hub-list">{next.map((f) => <li><a href={`/fields/${f.id}/`}>{f.name}</a><span>Planned</span></li>)}</ul>
        <p class="more"><a href="/swarm/explorer/">Compare all demos side by side</a></p>
      </section>
    </div>
    <div class="detail" style="margin-top:28px">
      <article class="prose"><Intro />
        <h2>Updates</h2>
        {updates.length ? <LogList entries={updates} compact /> : <p class="muted">New work on the swarm will appear here and in the <a href="/log/">activity log</a>.</p>}
      </article>
      <aside><div class="card lk"><h2>Demos</h2>{items.map((i) => <a href={i.data.demo}>{i.data.title} →</a>)}<a href="/swarm/explorer/">All demos compared →</a></div></aside>
    </div>
  </main>
</Base>

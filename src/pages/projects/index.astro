---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib';
import { FIELDS } from '../../data/fields';
const projects = await getProjects();
const cats = FIELDS.filter((f) => projects.some((p) => p.data.field === f.id));
---
<Base title="Projects" description="Projects by Nihal Sulaiman: hospitality BI warehouse and dashboards, swarm intelligence, wildfire drones, and Kaggle machine-learning work.">
  <PageHero title="Projects" crumbs={[{ label: 'Projects' }]} lead="Projects across my seven fields. My flagship, Swarm Intelligence, has its own section. Each write-up covers the problem, what I built, the hardest part and the result, including where my own changes didn't help." />
  <main>
    <div class="filters" role="group" aria-label="Filter projects">
      <button type="button" aria-pressed="true" data-f="all">All</button>
      {cats.map((c) => <button type="button" aria-pressed="false" data-f={c.id}>{c.name}</button>)}
    </div>
    <div class="pgrid" id="pgrid">{projects.map((p) => <ProjectCard p={p} />)}</div>
  </main>
  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.filters button');
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          btns.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
          var f = b.dataset.f;
          document.querySelectorAll('#pgrid .pcard').forEach(function (c) { c.hidden = f !== 'all' && c.dataset.cat !== f; });
        });
      });
    })();
  </script>
</Base>

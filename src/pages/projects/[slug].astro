---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getProjects, catClass } from '../../lib';
export async function getStaticPaths() {
  const ps = await getProjects();
  return ps.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={p.data.title} description={p.data.summary} type="article">
  <PageHero title={p.data.title} crumbs={[{ label: 'Projects', href: '/projects/' }, { label: p.data.title }]} lead={p.data.summary}>
    <div class="post-meta"><span class={`eyebrow ${catClass(p.data.category)}`} style="margin:0">{p.data.category}</span><span class={`status ${p.data.status}`}>{p.data.status}</span>
      <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div></div>
  </PageHero>
  <main>
    <div class="detail">
      <article class="prose"><Content /></article>
      <aside>
        {p.data.stats.length > 0 && <div class="card"><h2>Results</h2><div class="stat-row">{p.data.stats.map((s) => <div><b>{s.value}</b>{s.label}</div>)}</div></div>}
        {p.data.links.length > 0 && <div class="card lk"><h2>Links</h2>{p.data.links.map((l) => <a href={l.href}>{l.label} →</a>)}</div>}
      </aside>
    </div>
  </main>
</Base>

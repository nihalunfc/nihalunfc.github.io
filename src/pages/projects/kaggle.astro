---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE } from '../../site';
---
<Base title="Kaggle" description="Nihal Sulaiman's Kaggle competitions, leaderboard positions and how he reports them honestly.">
  <PageHero title="Kaggle" crumbs={[{ label: 'Kaggle' }]} lead="I use Kaggle to practise machine learning against hard deadlines and honest scoring. Here's where each competition stands and what part of the score is my own work.">
    <div class="btns"><a class="btn ghost" href={SITE.links.kaggle}>Kaggle profile</a></div>
  </PageHero>
  <main>
    <div class="card scroll">
      <table class="ktable">
        <thead><tr><th>Competition</th><th>Position</th><th>My contribution</th><th>Ends</th></tr></thead>
        <tbody>
          <tr><td><a href="/projects/name-that-llm/">Name That LLM</a></td><td class="n">436 of 4,346 (top 10%)</td><td>Extra data pool, LoRA fine-tunes, n-gram SVM tuning, leak-free validation</td><td class="n">Jan 2027</td></tr>
          <tr><td>Mallorn Challenge</td><td class="n">Top 15%</td><td>Gradient-boosted models (XGBoost, CatBoost, LightGBM) tuned with Optuna</td><td class="n">Ended</td></tr>
          <tr><td><a href="/projects/squares-in-squares/">Squares in Squares</a></td><td class="n">190 of 1,473 (top 13%)</td><td>Validator and submission pipeline; the score comes from combining public packings</td><td class="n">Jul 2027</td></tr>
          <tr><td><a href="/projects/smart-buildings/">NeurIPS 2026 Smart Buildings</a></td><td class="n">Score 0.01244</td><td>Own physics-informed controller and unseen-building validation; found and reported a simulator bug</td><td class="n">Jan 2027</td></tr>
          <tr><td><a href="/projects/casmi-2026/">Enveda CASMI 2026</a></td><td class="n">MRR 0.415</td><td>Leak-free 300-structure hold-out and own scorers; the score comes from a credited public fork</td><td class="n">Dec 2026</td></tr>
          <tr><td>CAFA protein function</td><td class="n">Not reported</td><td>ResNet multi-label model for GO terms with extreme class imbalance</td><td class="n">Ended</td></tr>
        </tbody>
      </table>
    </div>
    <div class="callout" style="margin-top:22px">
      <p><b>How I report ranks.</b> Positions are public-leaderboard figures from 2 November 2026 and can change when each private leaderboard is published. I never claim a score that came from someone else's public notebook, and I say so where a score comes from a fork.</p>
    </div>
  </main>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { getPosts, getProjects, getTools, getCourses, slugify } from '../lib';
import { FIELDS } from '../data/fields';
const posts = await getPosts();
const projects = await getProjects();
const tools = await getTools();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const swarm = (await getCollection('swarm')).sort((a, b) => a.data.order - b.data.order);
const courses = await getCourses();
const editions = tools.flatMap((t) => t.data.editions.filter((e) => e.href && e.href !== `/tools/${t.id}/`).map((e) => [e.href!, `${t.data.title}: ${e.sector}`] as [string, string]));
const groups: { title: string; links: [string, string, string?][] }[] = [
  { title: 'Main pages', links: [['/', 'Home'], ['/about/', 'About me'], ['/about/cv/', 'CV'], ['/now/', 'Now', 'What I am working on'], ['/log/', 'Activity log', 'What I did, entry by entry'], ['/contact/', 'Contact'], ['/search/', 'Search']] },
  { title: 'Swarm Intelligence', links: [['/swarm/', 'Swarm Intelligence', 'My flagship project'], ...swarm.map((s) => [s.data.demo || `/swarm/${s.id}/`, s.data.title] as [string, string]), ['/swarm/explorer/', 'All demos compared']] },
  { title: 'Fields', links: [['/fields/', 'All fields'], ...FIELDS.map((f) => [`/fields/${f.id}/`, f.name] as [string, string])] },
  { title: 'Projects', links: [['/projects/', 'All projects'], ...projects.map((p) => [`/projects/${p.id}/`, p.data.title] as [string, string]), ['/projects/hospitality-bi/overview/', 'Hospitality edition: overview'], ['/projects/hospitality-bi/proposals/', 'Hospitality edition: proposals'], ['/projects/kaggle/', 'Kaggle ranks']] },
  { title: 'Tools', links: [['/tools/', 'All tools'], ...tools.map((t) => [`/tools/${t.id}/`, t.data.title] as [string, string])] },
  { title: 'Tool editions (open and use)', links: editions },
  { title: 'Learn', links: [['/learn/', 'All courses'], ...courses.map((c) => [c.data.href, c.data.title] as [string, string])] },
  { title: 'Blog', links: [['/blog/', 'All posts'], ...posts.map((p) => [`/blog/${p.id}/`, p.data.title] as [string, string]), ['/rss.xml', 'RSS feed']] },
  { title: 'Blog topics', links: tags.map((t) => [`/blog/tags/${slugify(t)}/`, t] as [string, string]) },
  { title: 'About this site', links: [['/disclaimer/', 'Disclaimer and privacy'], ['/site-structure.md', 'Site structure map'], ['/update-log-rules.md', '#UpdateLog rules'], ['/sitemap-index.xml', 'XML sitemap', 'For search engines']] },
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Site map',
  itemListElement: groups.flatMap((g) => g.links).map(([href, name], i) => ({ '@type': 'SiteNavigationElement', position: i + 1, name, url: new URL(href, 'https://nihalsulaiman.com').href })),
};
---
<Base title="Site map" description="Every page on nihalsulaiman.com: projects, blog posts, Kaggle, CV, tools and demos." jsonld={ld}>
  <PageHero title="Site map" crumbs={[{ label: 'Site map' }]} lead="Every page on this site in one place." />
  <main>
    <div class="smap">
      {groups.map((g) => (
        <section>
          <h2>{g.title}</h2>
          <ul>{g.links.map(([href, label, sub]) => <li><a href={href}>{label}</a>{sub && <span>{sub}</span>}</li>)}</ul>
        </section>
      ))}
    </div>
  </main>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getPosts, getProjects, getTools, slugify } from '../lib';
const posts = await getPosts();
const projects = await getProjects();
const tools = await getTools();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const H = '/hotel-business/';
const groups: { title: string; links: [string, string, string?][] }[] = [
  { title: 'Main pages', links: [['/', 'Home'], ['/about/', 'About me'], ['/cv/', 'CV'], ['/now/', 'Now', 'What I am working on'], ['/log/', 'Activity log', 'What I did, entry by entry'], ['/contact/', 'Contact']] },
  { title: 'Projects', links: [['/projects/', 'All projects'], ...projects.map((p) => [`/projects/${p.id}/`, p.data.title] as [string, string]), ['/kaggle/', 'Kaggle ranks']] },
  { title: 'Blog', links: [['/blog/', 'All posts'], ...posts.map((p) => [`/blog/${p.id}/`, p.data.title] as [string, string]), ['/rss.xml', 'RSS feed']] },
  { title: 'Blog topics', links: tags.map((t) => [`/blog/tags/${slugify(t)}/`, t] as [string, string]) },
  { title: 'Swarm Intelligence demos', links: [['/swarm/', 'Overview'], ['/swarm/hotel/', 'Hotel operations'], ['/swarm/energy/', 'Grid batteries'], ['/swarm/wildfire/', 'Wildfire drones']] },
  { title: 'Hospitality BI', links: [[H, 'Hospitality BI home'], [H + 'revenue.html', 'Revenue command centre'], [H + 'dashboards/workforce/', 'Workforce dashboard'], [H + 'dashboards/operations/', 'Operations dashboard'], [H + 'schedule.html', 'Staff schedule builder'], [H + 'swarm/', 'AI swarm for hotels']] },
  { title: 'Learn', links: [['/learn/', 'Learn'], ['/learn/etl-course/', 'Pipeline to Dashboard course'], ['/learn/etl-course/pages/setup.html', 'Course setup'], ['/learn/etl-course/pages/projects.html', 'Course projects']] },
  { title: 'Tools', links: [['/tools/', 'All tools'], ['/sectors/', "Who it's for"], ...tools.map((t) => [`/tools/${t.id}/`, t.data.title])] },
  { title: 'Hospitality edition', links: [[H, 'Hospitality BI home'], [H + 'tools/index.html', 'All hotel tools']] },
  { title: 'About this site', links: [['/disclaimer/', 'Disclaimer and privacy'], ['/sitemap-index.xml', 'XML sitemap', 'For search engines']] },
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Site map',
  itemListElement: groups.flatMap((g) => g.links).map(([href, name], i) => ({ '@type': 'SiteNavigationElement', position: i + 1, name, url: new URL(href, 'https://nihalsulaiman.com').href })),
};
---
<Base title="Site map" description="Every page on nihalsulaiman.com: projects, blog posts, Kaggle, CV, tools and demos." jsonld={ld}>
  <PageHero title="Site map" crumbs={[{ label: 'Site map' }]} lead="Every page on this site in one place." />
  <main>
    <div class="smap">
      {groups.map((g) => (
        <section>
          <h2>{g.title}</h2>
          <ul>{g.links.map(([href, label, sub]) => <li><a href={href}>{label}</a>{sub && <span>{sub}</span>}</li>)}</ul>
        </section>
      ))}
    </div>
  </main>
</Base>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LogList from '../../components/LogList.astro';
import { getLog, projectHue } from '../../lib';
const entries = await getLog();
const projects = [...new Set(entries.map((e) => e.data.project))];
---
<Base title="Activity log" description="Nihal Sulaiman's activity log: each thing I built, fixed or started, with the time it happened. Every entry is a commit on GitHub.">
  <PageHero title="Activity log" crumbs={[{ label: 'Activity log' }]} lead="Every piece of work I do, finished or not, one entry at a time. Each entry is its own commit on GitHub, made at the time the work happened.">
    <p class="updated" style="margin-top:10px">{entries.length} entries across {projects.length} project{projects.length === 1 ? '' : 's'} · times in Eastern time · <a href="https://github.com/nihalunfc/nihalunfc.github.io/commits/main/src/content/log">see the commits</a> · <a href="/update-log-rules.md">how entries are written</a></p>
  </PageHero>
  <main>
    <div class="filters log-filter" role="group" aria-label="Filter by project">
      <button type="button" aria-pressed="true" data-f="all" style="--h:0;border-left-color:var(--line-2)!important">All</button>
      {projects.map((p) => <button type="button" aria-pressed="false" data-f={p} style={`--h:${projectHue(p)}`}>{p} <small>{entries.filter((e) => e.data.project === p).length}</small></button>)}
    </div>
    <LogList entries={entries} />
  </main>
  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.log-filter button');
      btns.forEach(function (b) { b.addEventListener('click', function () {
        btns.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var f = b.dataset.f;
        document.querySelectorAll('.logd li').forEach(function (li) { li.hidden = f !== 'all' && li.dataset.p !== f; });
        document.querySelectorAll('.logd section').forEach(function (s) { s.hidden = !s.querySelector('li:not([hidden])'); });
      }); });
    })();
  </script>
</Base>
